rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsPlayer(playerId) {
      return request.auth != null && request.auth.uid == playerId;
    }

    function validPlayer(playerId, data) {
      return data.keys().hasOnly([
          'playerId', 'createdAt', 'lastSeenAt', 'lastPlayedAt',
          'gamesPlayed', 'totalCoins', 'bestScore', 'bestDistance'
        ])
        && data.keys().hasAll([
          'playerId', 'createdAt', 'lastSeenAt',
          'gamesPlayed', 'totalCoins', 'bestScore', 'bestDistance'
        ])
        && data.playerId == playerId
        && data.createdAt is timestamp
        && data.lastSeenAt is timestamp
        && (!data.keys().hasAny(['lastPlayedAt']) || data.lastPlayedAt is timestamp)
        && data.gamesPlayed is int && data.gamesPlayed >= 0
        && data.totalCoins is int && data.totalCoins >= 0
        && data.bestScore is int && data.bestScore >= 0
        && data.bestDistance is int && data.bestDistance >= 0;
    }

    function validRun(data) {
      return data.keys().hasOnly([
          'score', 'distance', 'coins', 'dodges', 'hits', 'maxSpeed', 'createdAt'
        ])
        && data.keys().hasAll([
          'score', 'distance', 'coins', 'dodges', 'hits', 'maxSpeed', 'createdAt'
        ])
        && data.score is int && data.score >= 0
        && data.distance is int && data.distance >= 0
        && data.coins is int && data.coins >= 0
        && data.dodges is int && data.dodges >= 0
        && data.hits is int && data.hits >= 0
        && data.maxSpeed is int && data.maxSpeed >= 0
        && data.createdAt is timestamp;
    }

    match /players/{playerId} {
      allow read: if ownsPlayer(playerId);
      allow create: if ownsPlayer(playerId)
        && validPlayer(playerId, request.resource.data);
      allow update: if ownsPlayer(playerId)
        && validPlayer(playerId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.gamesPlayed >= resource.data.gamesPlayed
        && request.resource.data.totalCoins >= resource.data.totalCoins
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.bestDistance >= resource.data.bestDistance;
      allow delete: if false;

      match /runs/{runId} {
        allow read: if ownsPlayer(playerId);
        allow create: if ownsPlayer(playerId) && validRun(request.resource.data);
        allow update, delete: if false;
      }
    }

    function validRoom(data) {
      return data.keys().hasOnly([
          'createdAt', 'status', 'hostId', 'playerIds', 'winner', 'rematch'
        ])
        && data.keys().hasAll([
          'createdAt', 'status', 'hostId', 'playerIds', 'winner', 'rematch'
        ])
        && data.createdAt is timestamp
        && data.status in ['waiting', 'playing', 'finished', 'closed']
        && data.hostId is string
        && data.playerIds is list
        && data.playerIds.size() >= 1
        && data.playerIds.size() <= 6
        && data.hostId in data.playerIds
        && (data.winner == null || data.winner == 'draw' || data.winner is string)
        && data.rematch is map;
    }

    function validRoomPlayer(data) {
      return data.keys().hasOnly([
          'ready', 'x', 'distance', 'speed', 'score', 'alive', 'ping'
        ])
        && data.keys().hasAll([
          'ready', 'x', 'distance', 'speed', 'score', 'alive', 'ping'
        ])
        && data.ready is bool
        && (data.x is int || data.x is float)
        && data.x >= -8 && data.x <= 8
        && (data.distance is int || data.distance is float)
        && data.distance >= 0
        && data.speed is int && data.speed >= 0
        && data.score is int && data.score >= 0
        && data.alive is bool
        && data.ping is timestamp;
    }

    match /rooms/{code} {
      // Multiplayer rooms are public by design: joining only needs a six-character code.
      allow read: if true;
      allow create: if validRoom(request.resource.data)
        && request.resource.data.status == 'waiting';
      allow update: if validRoom(request.resource.data);
      allow delete: if true;

      match /players/{playerId} {
        allow read: if true;
        allow create, update: if validRoomPlayer(request.resource.data);
        allow delete: if true;
      }
    }
  }
}
